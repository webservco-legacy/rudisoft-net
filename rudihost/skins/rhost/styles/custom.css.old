/* ********** ********** ********** CUSTOM ********** ********** ********** */
DIV.vcentered {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 250px;
  height: 20px;
  margin-left: -125px; /* half of width */
  margin-top: -10px;  /* half of height */
  text-align: center;
}
.layout {
  min-height:100%;
  position: relative;
  background-image: url(<?php echo _RUDWEB_SKIN_URL . $_SESSION[_RUDWEB_PRE.'usr_skin_dir']?>/graphics/bg.jpg);
  background-position: top center;
  background-repeat: no-repeat;
  background-attachment: fixed;
  
}
* html .layout {height: 100%;}
.container {
  text-align: <?php echo $rudweb_skin['TextAlign']; ?>;
  clear: both;
  width: 770px;
  margin: auto;
}
/* ********** ********** ********** HEADER AREA START ********** ********** ********** */
.hdr1 {
  float: left;
  width: 226px;
  height: 160px;
  margin: 0px;
  padding: 0px;
}
* html .hdr1 {margin-right: -3px;}
.hdr2 {
  width: 500px; /*544*/
  height: 160px;
  margin-left: 226px;
  margin: 0px;
  padding: 0px 0px 0px 44px;
  background-image: url(<?php echo _RUDWEB_SKIN_URL . $_SESSION[_RUDWEB_PRE.'usr_skin_dir']?>/graphics/hdr2.jpg);
  background-repeat: no-repeat;
  overflow: hidden;
}
* html .hdr2 { margin-bottom: -3px;}
/* ********** ********** ********** HEADER AREA END ********** ********** ********** */
/* ********** ********** ********** CONTENT AREA START ********** ********** ********** */
.cnt1 {
  float: left;
  width: 225px;
  min-height: 370px;
  margin: 0px;
  padding: 0px;
  border-top: 1px solid #000000;
}
* html .cnt1 {height: 370px; margin-right: -3px;}
.cnt2 {
  width: 544px;
  min-height: 370px;
  margin: 0px;
  margin-left: 225px;
  padding: 0px;
  /*overflow: auto;*/
  border-top: 1px solid #000000;
  border-left: 1px solid #000000;
}
* html .cnt2 {height: 370px; margin-left: 222px;}
.cnt_right {
  float: right;
  width: 180px;
  min-height:370px;
  margin: 0;
  padding: 0;
}
* html .cnt_right {height: 370px;}
.cnt_main {
  width: 360px;
  min-height: 370px;
  margin: 0px 10px 0px 10px;
  padding: 0;
}
* html .cnt_main {height: 370px;}
.clear {
    clear:both;
    height:1px;
    overflow:hidden;
}
/* ********** ********** ********** CONTENT AREA END ********** ********** ********** */
/* ********** ********** ********** FOOTER AREA START ********** ********** ********** */
.ftr {
  width: 100%;
  height: 40px;
  padding: 0px 0px 0px 0px;
  text-align: center;
  position: absolute;
  bottom: 0;
}
.footer {
  width: 770px;
  height: 20px;
  padding: 10px 0px 10px 0px;
  font-size: 0.9em;
  text-align: center;
  margin: auto;
}
/* ********** ********** ********** FOOTER AREA END ********** ********** ********** */
.menu0 {
  padding: 10px 0px 10px 0px;
  border-bottom: 1px solid #000000;
}
.adm_mnu_hdr {

width: 200px;
line-height: 210%;
margin-top: 30px;
}
.adm_mnu_hd {
font-weight: bold;
padding-left: 5px;
